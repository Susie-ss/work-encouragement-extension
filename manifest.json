{
  "manifest_version": 3,
  "name": "上班鼓励器",
  "short_name": "鼓励器",
  "version": "1.0.0",
  "description": "实时显示今日已赚工资、工作时长、当前状态——让上班更有动力",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "上班鼓励器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}